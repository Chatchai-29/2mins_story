# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง ( cp .env.example .env )
# ห้าม commit .env เข้า git และห้าม print ค่าออกมาใน log/หน้าจอ

# fal.ai — ใช้เจนวิดีโอ Kling image-to-video
# หาได้ที่ https://fal.ai/dashboard/keys
FAL_KEY=

# ElevenLabs — ใช้เจนเพลงคลอ (Eleven Music) + sound effects
# หาได้ที่ https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# EvoLink — ใช้เจนวิดีโอถูก (Seedance) สำหรับนิช mass-produce ที่ไม่ต้องสวย/สมจริงมาก
# หาได้ที่ https://evolink.ai/dashboard/keys
# ล็อกไว้แค่ 3 โมเดลถูกสุด @480p ใน scripts/config.mjs (EVOLINK_MODELS) — ดู scripts/gen-video-evolink.mjs
EVOLINK_API_KEY=

# โหมดอัปสเกลวิดีโอ 720p -> 1080p (ไม่ใส่ = local)
#   local = ffmpeg ในเครื่อง — ฟรี, ~2 วินาที/คลิป
#   api   = Bytedance Upscaler — $0.0072/วิ (~$0.60 AUD ต่อคลิป 60วิ), ช้ากว่า แต่คมกว่าเล็กน้อย
#   none  = ไม่อัปสเกล (ได้ 720p)
UPSCALE_MODE=local
